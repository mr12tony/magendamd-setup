{
    "$schema": "https://schema.tauri.app/config/2",
    "bundle": {
        "targets": [
            "nsis"
        ],
        "resources": [
            "resources/windows/rustdesk-1.4.9-x86_64.exe",
            "resources/windows/rustdesk-1.4.9-aarch64.exe",
            "resources/windows/configure-rustdesk.ps1"
        ],
        "windows": {
            "signCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/windows/sign-artifact.ps1 %1",
            "nsis": {
                "installMode": "perMachine",
                "installerHooks": "./windows/hooks.nsh",
                "installerIcon": "icons/icon.ico"
            }
        }
    }
}