{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MagendaSupport",
  "version": "0.1.0",
  "identifier": "com.mr12tony.magendamd-setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Magenda Support",
        "width": 480,
        "height": 400,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/windows/rustdesk-1.4.9-x86_64.exe",
      "resources/windows/rustdesk-1.4.9-aarch64.exe",
      "resources/windows/configure-rustdesk.ps1"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magendasupport"
        ]
      }
    }
  }
}