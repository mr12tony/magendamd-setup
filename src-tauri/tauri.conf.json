{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MagendaSupport",
  "version": "0.0.3",
  "identifier": "com.magendamd.support",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Magenda Support",
        "width": 480,
        "height": 400,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magendasupport"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1RDM4OEI1RTlCQTIwNkMKUldSc0lMcnB0WWpUZFExbHVtOUdDc2ZJeGJvLzBrQitzYmdld2g0Vkdyay8xSWI3MWpYOVo4MDkK",
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}